{
  "name": "figma-ui-agent",
  "version": "1.0.0",
  "description": "A Figma plugin built with React and Vite",
  "main": "dist/code.js",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.admin.config.mts",
    "build": "npm run build:ui && npm run build:main",
    "build:main": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es6",
    "build:ui": "vite build && node scripts/copy-ui.js",
    "build:admin": "vite build --config vite.admin.config.mts",
    "watch": "concurrently \"npm run watch:main\" \"npm run watch:ui\"",
    "watch:main": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es6 --watch",
    "watch:ui": "vite build --watch"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "codepage": "^1.15.0",
    "echarts": "^5.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.84.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.11",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
